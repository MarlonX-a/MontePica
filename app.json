{
  "expo": {
    "name": "MontePica",
    "slug": "MontePica",
    "scheme": "montepica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.marlonx.montepica",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite que MontePica use la cámara para escanear códigos QR de mesa y fotografiar comprobantes de transferencia.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MontePica necesita acceso a tus fotos para seleccionar el comprobante de transferencia.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite a MontePica adjuntar tu ubicación a una solicitud de domicilio."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      ["expo-notifications", { "defaultChannel": "delivery" }]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "17da8a27-432d-45da-a782-2ec559421cb3"
      }
    },
    "owner": "marlonx-as-team"
  }
}
